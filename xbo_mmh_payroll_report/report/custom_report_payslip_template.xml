<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_payslip_inherit_remove_code"
              inherit_id="om_hr_payroll.report_payslip">

        <!-- Remove Code Header -->
        <xpath expr="//th[text()='Code']" position="replace">
        </xpath>
        <xpath expr="//th[text()='Quantity/rate']" position="replace">
            <th>Number Of Days</th>
        </xpath>

        <!-- Remove Code Field -->
        <xpath expr="//td/span[@t-field='line.code']/.." position="replace">
        </xpath>

        <xpath expr="//td/span[@t-field='line.quantity']/.." position="replace">
            <td>

                <t t-if="line.name == 'Basic Salary'">

                    <span t-esc="
                        o.worked_days_line_ids.filtered(
                            lambda w: w.name == 'Normal Working Days paid at 100%'
                        )[:1].number_of_days
                    "/>

                </t>

                <t t-if="line.name == 'Paid Time Off'">

                    <span t-esc="
                        abs(o.worked_days_line_ids.filtered(
                            lambda w: w.name == 'Paid Time Off'
                        )[:1].number_of_days)
                    "/>

                </t>

                <t t-if="line.name == 'Special Leave'">

                    <span t-esc="
                        abs(o.worked_days_line_ids.filtered(
                            lambda w: w.name == 'Special Leave'
                        )[:1].number_of_days)
                    "/>

                </t>

                <t t-if="line.name == 'Public Holiday'">

                    <span t-esc="
                        abs(o.worked_days_line_ids.filtered(
                            lambda w: w.name == 'Global Leaves'
                        )[:1].number_of_days)
                    "/>

                </t>

                <t t-if="line.name == 'Short Hours Deduction'">

                    <span t-esc="o.late_count"/>

                </t>

                <t t-if="line.name == 'Late Deduction'">

                    <span t-esc="o.shd_count"/>

                </t>

            </td>
        </xpath>

        <xpath expr="//table[2]/thead" position="attributes">

            <attribute name="style">
                background-color:#c2d6d6;
            </attribute>

        </xpath>

        <xpath expr="//table[2]/thead/tr/th[1]" position="attributes">
            <attribute name="style">
                font-weight:bold;
                color:black;
            </attribute>
        </xpath>
        <xpath expr="//table[2]/thead/tr/th[2]" position="attributes">
            <attribute name="style">
                font-weight:bold;
                color:black;
            </attribute>
        </xpath>

        <xpath expr="//table[2]/thead/tr/th[3]" position="attributes">
            <attribute name="style">
                font-weight:bold;
                color:black;
            </attribute>
        </xpath>

        <xpath expr="//p[strong='Authorized signature']"
               position="replace">

            <p style="
                text-align:center;
                font-weight:bold;
                margin-top:50px;
            ">

                <strong>This is an automatically generated payslip and does not require any signature</strong>

            </p>

        </xpath>

        <xpath expr="//tbody/tr[@t-as='line']"
               position="attributes">

            <attribute name="t-att-style">
                'background-color:#c2d6d6; font-weight:bold;'
                if line.name in ['Gross','Taxable Salary','Net Salary']
                else ''
            </attribute>

        </xpath>

        <xpath expr="//span[@t-field='o.date_from']"
               position="attributes">

            <attribute name="t-options">
                {"format": "dd/MM/yyyy"}
            </attribute>

        </xpath>

        <!-- Date To -->
        <xpath expr="//span[@t-field='o.date_to']"
               position="attributes">

            <attribute name="t-options">
                {"format": "dd/MM/yyyy"}
            </attribute>

        </xpath>

    </template>

</odoo>