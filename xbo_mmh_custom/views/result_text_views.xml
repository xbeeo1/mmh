<odoo>
    <record id="result_text_view_list" model="ir.ui.view">
        <field name="name">result.text.list</field>
        <field name="model">result.text</field>
        <field name="arch" type="xml">
            <list string="Result Text">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="result_text_view_form" model="ir.ui.view">
        <field name="name">result.text.form</field>
        <field name="model">result.text</field>
        <field name="arch" type="xml">
            <form string="Result Text">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_result_text" model="ir.actions.act_window">
        <field name="name">Result Text</field>
        <field name="res_model">result.text</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_result_text"
              name="Result Text"
              action="action_result_text"
              parent="basic_hms.main_menu_configartion"
              sequence="10"/>
</odoo>