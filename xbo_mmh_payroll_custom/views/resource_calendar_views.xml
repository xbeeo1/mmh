<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_resource_calendar_form" model="ir.ui.view">
        <field name="name">resource.calendar.view.form.inherit</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">

            <!-- Full Time Required Hours -->
            <xpath expr="//field[@name='full_time_required_hours']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//label[@for='full_time_required_hours'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//label[@for='full_time_required_hours'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Work Time Rate -->
            <xpath expr="//field[@name='work_time_rate']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//label[@for='work_time_rate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>


</odoo>