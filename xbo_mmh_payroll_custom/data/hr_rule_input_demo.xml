<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="1">
        <!-- Demo data: Define a rule input for loans -->
        <record id="hr_rule_input_loan" model="hr.rule.input">
            <field name="code">LO</field>
            <field name="name">Loan</field>
            <field name="input_id" ref="hr_rule_loan"/>
        </record>

        <record id="hr_rule_input_loan_pf" model="hr.rule.input">
            <field name="code">LOPF</field>
            <field name="name">Loan Against Provident Fund</field>
            <field name="input_id" ref="hr_rule_loan_against_pf"/>
        </record>

        <record id="hr_rule_input_loan_as" model="hr.rule.input">
            <field name="code">LOAS</field>
            <field name="name">Advance Against Salary</field>
            <field name="input_id" ref="hr_rule_loan_against_as"/>
        </record>

        <record id="hr_rule_input_ld" model="hr.rule.input">
            <field name="code">LD</field>
            <field name="name">Late Deduction</field>
            <field name="input_id" ref="hr_rule_ldpf"/>
        </record>
        <record id="hr_rule_input_shd" model="hr.rule.input">
            <field name="code">SHD</field>
            <field name="name">Short hours Deduction</field>
            <field name="input_id" ref="hr_rule_shd"/>
        </record>
	</data>
</odoo>
