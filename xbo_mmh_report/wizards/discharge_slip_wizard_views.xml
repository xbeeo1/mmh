<odoo>
    <record id="view_discharge_slip_wizard" model="ir.ui.view">
        <field name="name">discharge.slip.wizard.form</field>
        <field name="model">discharge.slip.wizard</field>
        <field name="arch" type="xml">
            <form string="Discharge Slip">
                <group>
                    <field name="patient_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_discharge_slip_wizard" model="ir.actions.act_window">
        <field name="name">Discharge Slip</field>
        <field name="res_model">discharge.slip.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

